rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Artifacts are readable by anyone (guests included) so the archive
    // stays publicly browsable. Only a signed-in user can create a record,
    // and only the record's own contributor can edit or delete it.
    match /artifacts/{artifactId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.contributorId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.contributorId == request.auth.uid;
    }
  }
}
