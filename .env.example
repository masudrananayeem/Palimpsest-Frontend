# Copy this file to .env and fill in your own values.
# Nothing here is a secret except values that stay server-side (see backend/.env.example) —
# Firebase web config and the Cloudinary cloud name / API key are meant to be public.

# ---- Firebase (Project settings → General → Your apps → Web app) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Cloudinary (Dashboard → cloud name + API key are both public) ----
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_FOLDER=palimpsest

# ---- Backend worker (see /backend) ----
# Local dev:  http://127.0.0.1:8787
# Production: https://palimpsest-api.<your-subdomain>.workers.dev
VITE_API_BASE_URL=http://127.0.0.1:8787

# ---- Admin ----
# Comma-separated list of "owner" emails — the bootstrap admin tier.
# Owners get the Admin panel, and from there can grant/revoke admin access
# for anyone else without touching code. Owners themselves can only be set
# here (in code) — there's no in-app way to add or remove an owner, so
# access can't be escalated by clicking around the UI.
# This SAME list must also be pasted into firestore.rules (see the
# isOwner() function there) so the permission is enforced server-side too,
# not just hidden in the UI.
VITE_ADMIN_EMAILS=you@example.com
